# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า:  cp .env.example .env
# บนคลาวด์ (Railway / Vercel) ให้ใส่ค่าเดียวกันในหน้า Variables / Environment Variables แทน
# แก้ค่าแล้วต้อง deploy ใหม่หนึ่งครั้ง

# ======================================================================
# ตัวตนของบอท
# ======================================================================

# ต้องกรอกจริงแค่ 3 ค่า: LINE_CHANNEL_ACCESS_TOKEN · LINE_CHANNEL_SECRET · OPENROUTER_API_KEY
# + OWNER_CODE ไว้บอกหน้าที่บอทผ่านแชท LINE หลังติดตั้ง · ที่เหลือในไฟล์นี้ไม่ต้องแตะ

# ชื่อบอท — ไม่ต้องตั้ง ระบบใช้ชื่อ LINE Official Account ให้เอง · ตั้งไว้ = ใช้ชื่อนี้แทน
# BOT_NAME=น้องมะลิ

# คำแทนตัวเอง — ไม่ต้องตั้งก็ได้ ระบบเดาจากชื่อให้
#   "น้องมะลิ" → "น้อง"  ·  "พี่หมี" → "พี่"  ·  ชื่อ OA อื่น (เช่นชื่อร้าน) → "แอดมิน"  ·  BOT_NAME อื่น → เรียกชื่อตัวเองเต็ม
# BOT_SELF=น้อง

# คำลงท้าย: ปล่อยว่าง = ค่ะ/นะคะ · ใส่ "ชาย" = ครับ ทั้งบอท
# BOT_POLITE=ชาย

# อิโมจิประจำตัว (ค่าเริ่มต้น 💙)
# BOT_EMOJI=🌼

# ข้อความทักทายตอนมีคนแอดเพื่อน (ไม่ตั้ง = ทักแบบมาตรฐานด้วยชื่อบอท)
# BOT_GREETING=สวัสดีค่ะ ร้านบ้านมะลิยินดีต้อนรับ พิมพ์ถามเมนูหรือสั่งของได้เลยนะคะ

# ======================================================================
# หน้าที่ของบอท — ไม่ต้องตั้งตอนติดตั้ง: เจ้าของพิมพ์ OWNER_CODE หาบอท แล้วเล่าให้ฟังในแชท LINE
#   อยากเขียนเป็นไฟล์แทน: brief.txt (เลือกแบบจากโฟลเดอร์ briefs/) หรือ BOT_BRIEF ด้านล่าง (คำสั่งสั้นบรรทัดเดียว)
# ======================================================================
# BOT_BRIEF=คุณคือเลขาส่วนตัวของเจ้าของ ช่วยจดงานและสรุปให้เมื่อถูกขอ
# BOT_BRIEF_FILE=./brief.txt

# ======================================================================
# โหมดเจ้าของ — รหัสลับ 8 ตัวขึ้นไป เจ้าของพิมพ์รหัสนี้ส่งหาบอท 1 ครั้ง
# แล้วบอกหน้าที่บอท / ถามสรุปแชทลูกค้า / แก้ราคา ผ่าน LINE ได้เลย (ไม่ตั้ง = ปิดโหมดเจ้าของ)
# ตั้งให้เดายาก อย่าใช้เบอร์โทรหรือวันเกิด
# ======================================================================
OWNER_CODE=

# --- LINE Messaging API (developers.line.biz) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- AI ผ่าน OpenRouter (openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# AI_MODEL=deepseek/deepseek-v4.1-flash        # โมเดลตอบแชท (ร้านสุขภาพ/ความงาม แนะนำ anthropic/claude-haiku-5.5)
# AI_FALLBACK_MODEL=google/gemini-3.1-flash-lite # ตัวสำรองตอนตัวหลักล่ม (none = ไม่ใช้)
# VISION_MODEL=google/gemini-3.1-flash-lite     # อ่านรูป/เสียง/วิดีโอ — ต้องเป็นตระกูล gemini (รับเสียง+วิดีโอ)
# OWNER_MODEL=google/gemini-3.1-flash-lite      # โหมดเจ้าของ (ร่าง/แก้หน้าที่ สรุปแชท) — สำรองด้วย AI_MODEL ให้เอง

# --- กันค่า AI บาน: จำนวนข้อความสูงสุดต่อคนต่อวัน (0 = ไม่จำกัด · เจ้าของไม่นับ) ---
# DAILY_LIMIT=100

# ======================================================================
# ฐานข้อมูล (ความจำบทสนทนา) — เลือกตามที่รันบอท
#   Railway / เครื่องตัวเอง: ไม่ต้องตั้งอะไร (ได้ไฟล์ chatbot.db) · บน Railway ตั้ง DB_PATH=/data/chatbot.db
#   Vercel: ต้องใช้ Turso (turso.tech ฟรี) เพราะ Vercel ไม่มีดิสก์ถาวร
# ======================================================================
# DB_PATH=/data/chatbot.db
# DATABASE_URL=libsql://ชื่อฐานข้อมูล-ชื่อบัญชี.turso.io
# DATABASE_AUTH_TOKEN=

# --- รหัสดาวน์โหลดไฟล์สำรอง /admin/backup (เฉพาะแบบไฟล์ — ใครมีรหัสนี้โหลดแชททั้งหมดได้) ---
ADMIN_KEY=

# --- อื่นๆ ---
# PORT=3000
# APP_URL=https://xxx.up.railway.app    # ที่อยู่จริงของบอท — ใช้ตอน bin/backup-db.sh ดึงไฟล์สำรอง
TZ=Asia/Bangkok                         # เครื่องตัวเอง/Railway ใส่ไว้ได้ · บน Vercel ห้ามตั้ง (ระบบสงวนไว้ ไม่ต้องใช้ บอทคิดเวลาไทยเอง)
